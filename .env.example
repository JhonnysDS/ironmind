# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas variables la app funciona en "modo local".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Pon true solo cuando actives Google en Supabase (Authentication → Sign In / Providers → Google).
VITE_GOOGLE_LOGIN=false
# Clave PÚBLICA de notificaciones (npx web-push generate-vapid-keys). La privada va solo en Supabase.
VITE_VAPID_PUBLIC_KEY=
